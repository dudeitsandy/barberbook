// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations based on role
  businessOwned Business? // If role is BUSINESS
  bookings      Booking[] // If role is CUSTOMER
  favorites     Favorite[]
  Queue         Queue[]
}

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
}

model Business {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner     User       @relation(fields: [ownerId], references: [id])
  locations Location[]
  employees Employee[]
  services  Service[]
  bookings  Booking[]
  queue     Queue[]
}

model Location {
  id           String    @id @default(cuid())
  name         String
  address      String
  city         String
  state        String
  zipCode      String
  phone        String?
  email        String?
  businessId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  business     Business   @relation(fields: [businessId], references: [id])
  employees    Employee[]
  services     Service[]
  bookings     Booking[]
  queue        Queue[]
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  businessId String
  locationId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  business    Business   @relation(fields: [businessId], references: [id])
  location    Location   @relation(fields: [locationId], references: [id])
  services    Service[]
  bookings    Booking[]
  favoritedBy Favorite[]
  Queue       Queue[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int // in minutes
  price       Float
  businessId  String
  locationId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  business  Business   @relation(fields: [businessId], references: [id])
  location  Location?  @relation(fields: [locationId], references: [id])
  employees Employee[]
  bookings  Booking[]
  Queue     Queue[]
}

model Booking {
  id            String        @id @default(cuid())
  date          DateTime
  status        BookingStatus @default(PENDING)
  notes         String?
  businessId    String
  locationId    String
  serviceId     String
  employeeId    String
  userId        String? // Optional for non-registered customers
  customerName  String // For both registered and non-registered customers
  customerEmail String
  customerPhone String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  employeeId String
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([userId, employeeId])
}

enum QueueStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Queue {
  id              String      @id @default(cuid())
  locationId      String
  date            DateTime    @default(now())
  status          QueueStatus @default(WAITING)
  position        Int
  estimatedTime   DateTime?
  actualStartTime DateTime?
  actualEndTime   DateTime?
  customerId      String?
  customerName    String
  customerPhone   String?
  serviceId       String
  employeeId      String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  location   Location  @relation(fields: [locationId], references: [id])
  customer   User?     @relation(fields: [customerId], references: [id])
  service    Service   @relation(fields: [serviceId], references: [id])
  employee   Employee? @relation(fields: [employeeId], references: [id])
  Business   Business? @relation(fields: [businessId], references: [id])
  businessId String?
}
